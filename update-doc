#!/bin/bash

# ===================================================================
# 📚 Documentation Update System - update-doc Command
# Purpose: Automate documentation mapping from source code and 
#          uncommitted changes to .agent directory
# Author: Claude Code Assistant
# Version: 1.0.0
# ===================================================================

set -e  # Exit on any error

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Project root directory
PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
AGENT_DIR="$PROJECT_ROOT/.agent"

# Logging function
log() {
    echo -e "${BLUE}[update-doc]${NC} $1"
}

error() {
    echo -e "${RED}[ERROR]${NC} $1" >&2
}

success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

# Help function
show_help() {
    cat << EOF
📚 Documentation Update System

USAGE:
    ./update-doc [COMMAND] [OPTIONS]

COMMANDS:
    init           Initialize .agent directory structure
    scan           Scan and map current source code
    git-changes    Map uncommitted git changes
    api-docs       Generate API documentation from backend
    architecture   Update architecture documentation
    sync           Full synchronization of all documentation
    clean          Clean temporary files
    status         Show documentation status

OPTIONS:
    --force        Force overwrite existing documentation
    --dry-run      Show what would be updated without making changes
    --verbose      Verbose output
    --help         Show this help message

EXAMPLES:
    ./update-doc init                    # Initialize .agent structure
    ./update-doc scan                    # Map source code to documentation
    ./update-doc git-changes             # Map uncommitted changes
    ./update-doc sync --force            # Full sync with overwrite
    ./update-doc api-docs --verbose      # Generate API docs with details

EOF
}

# Initialize .agent directory structure
init_agent_structure() {
    log "Initializing .agent directory structure..."
    
    mkdir -p "$AGENT_DIR"/{tasks,system,sops,templates,reports,logs,mappings}
    
    # Create README structure
    cat > "$AGENT_DIR/readme.md" << 'EOF'
# 📚 Agent Documentation Directory

## 📁 Directory Structure

- **`tasks/`** - Feature documentation and implementation plans
- **`system/`** - System architecture and technical documentation  
- **`sops/`** - Standard Operating Procedures
- **`templates/`** - Documentation templates
- **`reports/`** - Analysis and progress reports
- **`logs/`** - Documentation update logs
- **`mappings/`** - Code-to-documentation mappings

## 🔄 Documentation Update Commands

```bash
./update-doc init         # Initialize structure
./update-doc scan         # Map source code
./update-doc git-changes  # Map git changes
./update-doc sync         # Full synchronization
```

## 📊 Documentation Status

Last Updated: $(date)
Total Files: 0
Coverage: 0%

---

*This documentation is automatically generated by the update-doc system*
EOF

    # Create mapping structure
    cat > "$AGENT_DIR/mappings/file_map.json" << 'EOF'
{
  "backend": {
    "api_routes": {},
    "processors": {},
    "models": {},
    "utils": {}
  },
  "frontend": {
    "scripts": {},
    "styles": {},
    "components": {}
  },
  "tests": {},
  "docs": {}
}
EOF

    success "Agent structure initialized successfully"
}

# Scan source code and map to documentation
scan_source_code() {
    log "Scanning source code for documentation mapping..."
    
    local dry_run=false
    if [[ "$1" == "--dry-run" ]]; then
        dry_run=true
        log "DRY RUN MODE - No changes will be made"
    fi
    
    # Backend components
    log "🔍 Scanning backend components..."
    
    # API Routes
    if [[ -d "backend/api/routes" ]]; then
        log "  📋 Found API routes"
        if [[ "$dry_run" == false ]]; then
            map_api_routes
        fi
    fi
    
    # Processors
    if [[ -d "backend/processors" ]]; then
        log "  ⚙️ Found processors"
        if [[ "$dry_run" == false ]]; then
            map_processors
        fi
    fi
    
    # Models
    if [[ -f "backend/app/models.py" ]]; then
        log "  📊 Found models"
        if [[ "$dry_run" == false ]]; then
            map_models
        fi
    fi
    
    # Frontend components
    log "🎨 Scanning frontend components..."
    
    if [[ -d "frontend/scripts" ]]; then
        log "  📜 Found frontend scripts"
        if [[ "$dry_run" == false ]]; then
            map_frontend_scripts
        fi
    fi
    
    if [[ -d "frontend/styles" ]]; then
        log "  🎨 Found frontend styles"
        if [[ "$dry_run" == false ]]; then
            map_frontend_styles
        fi
    fi
    
    success "Source code scanning completed"
}

# Map API routes to documentation
map_api_routes() {
    local api_dir="$AGENT_DIR/system/api_documentation.md"
    
    cat > "$api_dir" << 'EOF'
# 🚪 API Documentation

## Overview
This document describes all available API endpoints in the File Comparison System.

---

EOF

    # Find and document API routes
    find backend/api -name "*.py" -exec grep -l "router\|@app\|@.*\.post\|@.*\.get" {} \; | while read file; do
        local basename=$(basename "$file" .py)
        echo "## $basename" >> "$api_dir"
        echo "**File:** \`backend/api/$basename.py\`" >> "$api_dir"
        echo "" >> "$api_dir"
        
        # Extract route definitions
        grep -n "@.*\.\(get\|post\|put\|delete\|patch\)" "$file" | head -10 >> "$api_dir" || true
        echo "" >> "$api_dir"
        echo "---" >> "$api_dir"
        echo "" >> "$api_dir"
    done
    
    log "API routes documented in system/api_documentation.md"
}

# Map processors to documentation
map_processors() {
    local processors_dir="$AGENT_DIR/system/processors.md"
    
    cat > "$processors_dir" << 'EOF'
# ⚙️ File Processors Documentation

## Overview
This document describes all file processing components in the system.

---

EOF

    # List all processors
    find backend/processors -name "*_processor.py" | while read file; do
        local basename=$(basename "$file" .py)
        local classname=$(sed 's/_processor.py//; s/_/ /g; s/\b\w/\u&/g' <<< "$basename")
        
        echo "## $classname" >> "$processors_dir"
        echo "**File:** \`backend/processors/$basename.py\`" >> "$processors_dir"
        echo "**Class:** \`$classname\`" >> "$processors_dir"
        echo "" >> "$processors_dir"
        
        # Extract class methods
        grep -n "def " "$file" | head -5 >> "$processors_dir" || true
        echo "" >> "$processors_dir"
        echo "---" >> "$processors_dir"
        echo "" >> "$processors_dir"
    done
    
    log "Processors documented in system/processors.md"
}

# Map models to documentation
map_models() {
    local models_dir="$AGENT_DIR/system/data_models.md"
    
    cat > "$models_dir" << 'EOF'
# 📊 Data Models Documentation

## Overview
This document describes all data models used in the system.

---

EOF

    if [[ -f "backend/app/models.py" ]]; then
        echo "## Pydantic Models" >> "$models_dir"
        echo "**File:** \`backend/app/models.py\`" >> "$models_dir"
        echo "" >> "$models_dir"
        
        # Extract class definitions
        grep -n "class.*BaseModel\|class.*Enum" backend/app/models.py | while read line; do
            echo "### $(echo $line | sed 's/.*class \([A-Za-z0-9_]*\).*/\1/')" >> "$models_dir"
            echo "$line" >> "$models_dir"
            echo "" >> "$models_dir"
        done
    fi
    
    log "Models documented in system/data_models.md"
}

# Map frontend scripts
map_frontend_scripts() {
    local scripts_dir="$AGENT_DIR/system/frontend_scripts.md"
    
    cat > "$scripts_dir" << 'EOF'
# 📜 Frontend Scripts Documentation

## Overview
This document describes all frontend JavaScript components.

---

EOF

    find frontend/scripts -name "*.js" | while read file; do
        local basename=$(basename "$file" .js)
        local title=$(sed 's/_/ /g; s/\b\w/\u&/g' <<< "$basename")
        
        echo "## $title" >> "$scripts_dir"
        echo "**File:** \`frontend/scripts/$basename.js\`" >> "$scripts_dir"
        echo "" >> "$scripts_dir"
        
        # Extract main functions
        grep -n "function\|async.*function\|const.*function" "$file" | head -5 >> "$scripts_dir" || true
        echo "" >> "$scripts_dir"
        echo "---" >> "$scripts_dir"
        echo "" >> "$scripts_dir"
    done
    
    log "Frontend scripts documented in system/frontend_scripts.md"
}

# Map frontend styles
map_frontend_styles() {
    local styles_dir="$AGENT_DIR/system/frontend_styles.md"
    
    cat > "$styles_dir" << 'EOF'
# 🎨 Frontend Styles Documentation

## Overview
This document describes all CSS styles and components.

---

EOF

    find frontend/styles -name "*.css" | while read file; do
        local basename=$(basename "$file" .css)
        local title=$(sed 's/_/ /g; s/\b\w/\u&/g' <<< "$basename")
        
        echo "## $title" >> "$styles_dir"
        echo "**File:** \`frontend/styles/$basename.css\`" >> "$styles_dir"
        echo "" >> "$styles_dir"
        
        # Extract main CSS classes
        grep -n "\." "$file" | grep -v ":\." | head -10 >> "$styles_dir" || true
        echo "" >> "$styles_dir"
        echo "---" >> "$styles_dir"
        echo "" >> "$styles_dir"
    done
    
    log "Frontend styles documented in system/frontend_styles.md"
}

# Map uncommitted git changes
map_git_changes() {
    log "Mapping uncommitted git changes..."
    
    local changes_file="$AGENT_DIR/reports/uncommitted_changes.md"
    local timestamp=$(date '+%Y-%m-%d %H:%M:%S')
    
    cat > "$changes_file" << EOF
# 📝 Uncommitted Changes Report

**Generated:** $timestamp  
**Branch:** $(git branch --show-current 2>/dev/null || echo "Unknown")  
**Status:** Working directory changes

---

## 📊 Summary

EOF

    # Get git status summary
    local added=$(git status --porcelain 2>/dev/null | grep "^??" | wc -l || echo "0")
    local modified=$(git status --porcelain 2>/dev/null | grep "^ M" | wc -l || echo "0")
    local deleted=$(git status --porcelain 2>/dev/null | grep "^ D" | wc -l || echo "0")
    
    echo "- **New files:** $added" >> "$changes_file"
    echo "- **Modified files:** $modified" 
    echo "- **Deleted files:** $deleted"
    echo "- **Total changes:** $((added + modified + deleted))"
    echo "" >> "$changes_file"
    echo "---" >> "$changes_file"
    echo "" >> "$changes_file"
    
    # Document new files
    if [[ $added -gt 0 ]]; then
        echo "## 🆕 New Files" >> "$changes_file"
        echo "" >> "$changes_file"
        git status --porcelain 2>/dev/null | grep "^??" | while read line; do
            local file=$(echo "$line" | sed 's/^?? //')
            echo "### \`$file\`" >> "$changes_file"
            
            if [[ -f "$file" ]]; then
                local size=$(wc -c < "$file" 2>/dev/null || echo "0")
                local type=$(file -b "$file" 2>/dev/null | cut -d',' -f1 || echo "Unknown")
                echo "- **Size:** $size bytes" >> "$changes_file"
                echo "- **Type:** $type" >> "$changes_file"
                
                # If it's a text file, add first few lines
                if [[ "$type" == "ASCII text" || "$file" == *.md || "$file" == *.txt || "$file" == *.json ]]; then
                    echo "- **Preview:**" >> "$changes_file"
                    echo '```' >> "$changes_file"
                    head -5 "$file" 2>/dev/null | sed 's/^/  /' >> "$changes_file" || true
                    echo '```' >> "$changes_file"
                fi
            fi
            echo "" >> "$changes_file"
        done
    fi
    
    # Document modified files
    if [[ $modified -gt 0 ]]; then
        echo "## ✏️ Modified Files" >> "$changes_file"
        echo "" >> "$changes_file"
        git status --porcelain 2>/dev/null | grep "^ M" | while read line; do
            local file=$(echo "$line" | sed 's/^ M //')
            echo "### \`$file\`" >> "$changes_file"
            echo "" >> "$changes_file"
        done
    fi
    
    # Document deleted files
    if [[ $deleted -gt 0 ]]; then
        echo "## 🗑️ Deleted Files" >> "$changes_file"
        echo "" >> "$changes_file"
        git status --porcelain 2>/dev/null | grep "^ D" | while read line; do
            local file=$(echo "$line" | sed 's/^ D //')
            echo "- \`$file\`" >> "$changes_file"
        done
        echo "" >> "$changes_file"
    fi
    
    success "Uncommitted changes documented in reports/uncommitted_changes.md"
}

# Generate API documentation
generate_api_docs() {
    log "Generating API documentation from backend..."
    
    # Check if backend is running
    if curl -s http://localhost:8001/api/health >/dev/null 2>&1; then
        log "Backend is running, fetching OpenAPI spec..."
        
        local api_docs_file="$AGENT_DIR/system/openapi_spec.json"
        if curl -s http://localhost:8001/docs.json -o "$api_docs_file" 2>/dev/null; then
            success "OpenAPI spec saved to system/openapi_spec.json"
            
            # Generate human-readable API docs
            local readable_docs="$AGENT_DIR/system/api_endpoints_generated.md"
            cat > "$readable_docs" << 'EOF'
# 🚪 Generated API Documentation

*This documentation is automatically generated from the running backend*

## Quick Access

- **Interactive Docs:** http://localhost:8001/docs
- **ReDoc:** http://localhost:8001/redoc
- **OpenAPI Spec:** `system/openapi_spec.json`

---

## Available Endpoints

EOF
            
            # Extract endpoints from OpenAPI spec if available
            if command -v python3 >/dev/null 2>&1; then
                python3 -c "
import json
try:
    with open('$api_docs_file', 'r') as f:
        spec = json.load(f)
    
    for path, methods in spec.get('paths', {}).items():
        for method, details in methods.items():
            if method in ['get', 'post', 'put', 'delete']:
                summary = details.get('summary', 'No description')
                tags = details.get('tags', ['default'])
                print(f'### {method.upper()} {path}')
                print(f'**Summary:** {summary}')
                print(f'**Tags:** {', '.join(tags)}')
                print()
except Exception as e:
    print(f'Error parsing OpenAPI spec: {e}')
" >> "$readable_docs" 2>/dev/null || true
            fi
            
            success "API documentation generated in system/api_endpoints_generated.md"
        else
            warning "Could not fetch OpenAPI spec from backend"
        fi
    else
        warning "Backend is not running on port 8001"
        log "Start backend with: cd backend && python main.py"
    fi
}

# Update architecture documentation
update_architecture() {
    log "Updating architecture documentation..."
    
    local arch_file="$AGENT_DIR/system/architecture_current.md"
    
    cat > "$arch_file" << 'EOF'
# 🏗️ Current System Architecture

*This documentation is automatically generated and reflects the current state*

---

## 📁 Project Structure

EOF
    
    # Generate directory tree
    echo '```' >> "$arch_file"
    find . -type f -name "*.py" -o -name "*.js" -o -name "*.html" -o -name "*.css" -o -name "*.md" | \
        grep -v node_modules | grep -v ".git" | \
        sed 's|[^/]*/|- |' | sort >> "$arch_file" 2>/dev/null || true
    echo '```' >> "$arch_file"
    
    echo "" >> "$arch_file"
    echo "## 📊 File Statistics" >> "$arch_file"
    echo "" >> "$arch_file"
    
    # Count different file types
    local py_files=$(find . -name "*.py" | wc -l | tr -d ' ')
    local js_files=$(find . -name "*.js" | wc -l | tr -d ' ')
    local html_files=$(find . -name "*.html" | wc -l | tr -d ' ')
    local css_files=$(find . -name "*.css" | wc -l | tr -d ' ')
    local md_files=$(find . -name "*.md" | wc -l | tr -d ' ')
    
    echo "| File Type | Count |" >> "$arch_file"
    echo "|-----------|-------|" >> "$arch_file"
    echo "| Python | $py_files |" >> "$arch_file"
    echo "| JavaScript | $js_files |" >> "$arch_file"
    echo "| HTML | $html_files |" >> "$arch_file"
    echo "| CSS | $css_files |" >> "$arch_file"
    echo "| Markdown | $md_files |" >> "$arch_file"
    
    success "Architecture documentation updated in system/architecture_current.md"
}

# Full synchronization
full_sync() {
    local force=false
    if [[ "$1" == "--force" ]]; then
        force=true
    fi
    
    log "Starting full documentation synchronization..."
    
    if [[ "$force" == true ]]; then
        log "FORCE MODE - Existing documentation will be overwritten"
    fi
    
    # Initialize structure
    init_agent_structure
    
    # Scan all components
    scan_source_code
    
    # Map git changes
    map_git_changes
    
    # Generate API docs
    generate_api_docs
    
    # Update architecture
    update_architecture
    
    # Update documentation index
    update_docs_index
    
    success "Full synchronization completed!"
}

# Update documentation index
update_docs_index() {
    local index_file="$AGENT_DIR/readme.md"
    local timestamp=$(date '+%Y-%m-%d %H:%M:%S')
    local total_files=$(find "$AGENT_DIR" -name "*.md" | wc -l | tr -d ' ')
    
    # Update the README with current stats
    sed -i '' "s/Last Updated:.*/Last Updated: $timestamp/" "$index_file"
    sed -i '' "s/Total Files:.*/Total Files: $total_files/" "$index_file"
    
    log "Documentation index updated with $total_files files"
}

# Clean temporary files
clean_temp_files() {
    log "Cleaning temporary files..."
    
    # Remove backup files
    find "$AGENT_DIR" -name "*.bak" -delete 2>/dev/null || true
    find "$AGENT_DIR" -name "*~" -delete 2>/dev/null || true
    find "$AGENT_DIR" -name ".DS_Store" -delete 2>/dev/null || true
    
    success "Temporary files cleaned"
}

# Show documentation status
show_status() {
    log "Documentation Status Report"
    echo "========================"
    
    local total_files=$(find "$AGENT_DIR" -name "*.md" | wc -l | tr -d ' ')
    local system_files=$(find "$AGENT_DIR/system" -name "*.md" | wc -l | tr -d ' ')
    local sops_files=$(find "$AGENT_DIR/sops" -name "*.md" | wc -l | tr -d ' ')
    local reports_files=$(find "$AGENT_DIR/reports" -name "*.md" | wc -l | tr -d ' ')
    
    echo "📊 Total Documentation Files: $total_files"
    echo "📋 System Documentation: $system_files"
    echo "📝 SOPs: $sops_files"  
    echo "📈 Reports: $reports_files"
    echo ""
    
    if [[ -f "$AGENT_DIR/reports/uncommitted_changes.md" ]]; then
        echo "🔄 Last git changes mapping: $(stat -f %Sm "$AGENT_DIR/reports/uncommitted_changes.md" 2>/dev/null || echo "Unknown")"
    fi
    
    echo ""
    echo "📁 Agent Directory Structure:"
    find "$AGENT_DIR" -type d | sed 's|.*/|- |' | sort
    
    echo ""
    echo "🔗 Quick Access:"
    echo "  - Main README: .agent/readme.md"
    echo "  - System docs: .agent/system/"
    echo "  - Reports: .agent/reports/"
    echo "  - SOPs: .agent/sops/"
}

# Main script logic
main() {
    # Change to project root
    cd "$(dirname "$0")"
    
    # Parse command line arguments
    case "${1:-help}" in
        "init")
            init_agent_structure
            ;;
        "scan")
            scan_source_code "$2"
            ;;
        "git-changes")
            map_git_changes
            ;;
        "api-docs")
            generate_api_docs
            ;;
        "architecture")
            update_architecture
            ;;
        "sync")
            full_sync "$2"
            ;;
        "clean")
            clean_temp_files
            ;;
        "status")
            show_status
            ;;
        "help"|"-h"|"--help")
            show_help
            ;;
        *)
            error "Unknown command: $1"
            show_help
            exit 1
            ;;
    esac
}

# Execute main function with all arguments
main "$@"