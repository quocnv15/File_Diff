# Application Settings
APP_NAME=File Comparison Backend
APP_VERSION=1.0.0
DEBUG=true
HOST=0.0.0.0
PORT=8000

# File Storage
UPLOAD_DIR=./storage/uploads
PROCESSED_DIR=./storage/processed
EXPORT_DIR=./storage/exports
MAX_FILE_SIZE_MB=50

# Processing Settings
PDF_PROCESSOR=markitdown
ENABLE_OCR=false
OCR_LANGUAGE=eng

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:5500,http://localhost:3000

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# Rate Limiting
RATE_LIMIT_UPLOADS=10
RATE_LIMIT_COMPARISONS=20
RATE_LIMIT_EXPORTS=5

# File Retention (hours)
FILE_RETENTION_HOURS=24
COMPARISON_RETENTION_HOURS=24
EXPORT_RETENTION_HOURS=24